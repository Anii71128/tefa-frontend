# Alamat backend Laravel (tanpa slash di akhir). Dipakai juga untuk URL gambar (/storage)
VITE_BACKEND_URL=http://localhost:8000

# Alamat API Laravel
VITE_API_BASE_URL=http://localhost:8000/api

# Midtrans Client Key (boleh publik). Sandbox diawali "SB-Mid-client-", produksi "Mid-client-"
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false

# Nomor WhatsApp admin TEFA, format 62 tanpa tanda +
VITE_WA_NUMBER=